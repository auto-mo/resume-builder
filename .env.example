# Copy this file to .env and fill in values. .env is gitignored — never commit it.

# ─── Public / single-user use ───────────────────────────────────────────────
# Optional. If set, this is the key owner-mode spends (see below). For a public
# deployment you can leave it blank so visitors must bring their own key or use
# a local model — the app never exposes this key to the browser.
ANTHROPIC_API_KEY=

# ─── Owner mode (optional, for a personalized hosted instance) ──────────────
# A secret code you type into the UI's API-key field. When it matches, the
# server swaps in ANTHROPIC_API_KEY (above) and unlocks resumes uploaded under
# the "owner" namespace. Leave blank to disable owner mode entirely.
# Use a long, unguessable value — it authorizes spending YOUR tokens.
OWNER_ACCESS_CODE=

# Owner-mode rate limit: max AI-backed requests per window (seconds).
# Protects an internet-exposed endpoint from draining your tokens if the code leaks.
OWNER_RATE_MAX=30
OWNER_RATE_WINDOW=3600

# Local / custom model endpoints (Ollama, LM Studio, vLLM). Leave unset on any
# server other people can reach: it lets a visitor make the server call
# addresses of their choosing. Set to 1 only when you run the app yourself.
ALLOW_CUSTOM_BASE_URL=
